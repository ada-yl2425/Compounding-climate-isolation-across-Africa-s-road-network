#!/bin/bash -l
#PBS -l select=1:ncpus=1:mem=2gb
#PBS -l walltime=00:20:00
#PBS -N road_align_fin

set -euo pipefail
: "${AUDIT_ROOT:?AUDIT_ROOT is required}"
: "${PYTHON_BIN:?PYTHON_BIN is required}"
cd "$AUDIT_ROOT/code"
"$PYTHON_BIN" -m hpc.finalize_road_speed_alignment \
  --registry "$AUDIT_ROOT/registry/road_speed_alignment_registry.csv" \
  --results-root "$AUDIT_ROOT/results" \
  --output "$AUDIT_ROOT/results/road_speed_alignment_output_manifest.json"
